// Fase 2: contenido dinámico (servicios, testimonios, configuración).
// Fase 3: usuarios y autenticación.
// Fase 4: agenda (disponibilidad y bloqueos).
// Fase 5: reservas.
// Fase 6: pagos PayPal.
// Fase 7: panel administrativo (auditoría).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceModality {
  VIDEOLLAMADA
  LLAMADA
  PRESENCIAL
}

model Service {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String
  durationMinutes Int
  price           Decimal          @db.Decimal(10, 2)
  currency        String           @default("USD")
  available       Boolean          @default(true)
  modality        ServiceModality  @default(VIDEOLLAMADA)
  category        String
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  bookings          Booking[]
  attentionRequests AttentionRequest[]

  @@index([available, sortOrder])
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

model Testimonial {
  id        String            @id @default(cuid())
  name      String
  text      String
  rating    Int
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
}

/// Configuración editable por el admin (Fase 7): textos de "quiénes somos",
/// FAQ, contacto, políticas, etc. Clave/valor flexible; `value` guarda JSON.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String?
  email        String   @unique
  /// Nombre de usuario elegido al registrarse — alternativa al correo para
  /// iniciar sesión (ver server/user-auth.ts::loginAccount). Nullable
  /// porque las cuentas creadas antes de este campo no tienen uno.
  username     String?  @unique
  phone        String?
  country      String?
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Estado "en línea" (Fase 3): interruptor manual del proveedor (rol
  /// ADMIN) para mostrar un botón de "Contactar ahora" en el sitio público.
  /// Sin WebSockets — se lee por polling/al cargar la página.
  isOnline   Boolean   @default(false)
  lastSeenAt DateTime?

  /// Habilitado por un ADMIN a mano, cliente por cliente (ver
  /// server/admin/clients.ts::setUserCreditApproval) -- mientras esté en
  /// false, "Créditos Beto" ni siquiera aparece como opción de pago para
  /// esta cuenta. No es un límite de monto, es solo "confío en esta
  /// persona para atenderla antes de que pague".
  canUseCredit Boolean @default(false)

  passwordResets  PasswordReset[]
  bookings        Booking[]
  auditLogs       AuditLog[]
  /// Perfil de tarotista vinculado a esta cuenta (null si el usuario no es
  /// un tarotista, ej. un cliente) — ver modelo Tarotista.
  tarotista       Tarotista?
  expoPushTokens  ExpoPushToken[]

  @@index([role])
}

/// Reestructuración de la agenda (arquitectura "perfiles de tarotistas +
/// disponibilidad en tiempo real", reemplaza el calendario tradicional):
/// cada tarotista es un perfil independiente y dinámico — el sistema NO
/// está programado para una cantidad fija de perfiles, se agregan filas
/// nuevas sin tocar código. Fase 1: solo el modelo y el estado, sin UI
/// todavía (ver Availability/BlockedTime, que siguen existiendo por ahora
/// y se retiran en una fase posterior cuando el nuevo flujo de consulta
/// las reemplace del todo).
enum TarotistaStatus {
  DISPONIBLE
  EN_CONSULTA
  EN_REPOSO
  DESCONECTADO
}

model Tarotista {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  photoUrl    String?
  bio         String?
  /// Lista libre de especialidades (ej. "Tarot", "Numerología") — mostrada
  /// en la ficha pública, editable sin migración.
  specialties String[]        @default([])
  experience  String?
  status      TarotistaStatus @default(DESCONECTADO)
  /// Cuándo cambió de estado por última vez — para mostrar "desde hace X"
  /// en el panel admin/propio más adelante.
  statusChangedAt DateTime    @default(now())
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  /// Cuenta de acceso al panel privado del tarotista (Fase 3) — null
  /// mientras el perfil todavía no tiene login propio creado.
  userId      String?         @unique
  user        User?           @relation(fields: [userId], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  bookings          Booking[]
  attentionRequests AttentionRequest[]
  pushSubscriptions PushSubscription[]

  @@index([active, sortOrder])
}

/// Suscripción push del navegador/teléfono del tarotista (Fase 9) —
/// estándar Web Push (sin proveedor externo, ver server/push-notifications.ts).
/// Un tarotista puede tener varias (ej. teléfono + laptop); `endpoint` es
/// único por navegador/dispositivo, así que reactivar la misma suscripción
/// no duplica la fila.
model PushSubscription {
  id          String    @id @default(cuid())
  tarotistaId String
  tarotista   Tarotista @relation(fields: [tarotistaId], references: [id])
  endpoint    String    @unique
  p256dh      String
  auth        String
  createdAt   DateTime  @default(now())

  @@index([tarotistaId])
}

/// Token de push nativo (Expo Push, app móvil, Módulo C) — separado de
/// PushSubscription (Web Push del navegador) porque el proveedor y el
/// formato del envío son distintos. Vinculado a User (no a Tarotista) para
/// que sirva tanto a clientes como a tarotistas — ver server/expo-push.ts.
model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([userId])
}

enum AttentionRequestStatus {
  PENDING
  CONTACTED
  DISMISSED
}

/// Solicitud pendiente (Fase 5): cuando un tarotista no está DISPONIBLE, el
/// cliente puede dejar sus datos en vez de una consulta inmediata. NO
/// reserva ningún horario ni bloque de agenda — es solo una nota para que
/// el tarotista la revise desde su panel (ver server/tarotista-panel.ts) y
/// decida si contacta a la persona por su cuenta (WhatsApp, etc.).
model AttentionRequest {
  id            String                  @id @default(cuid())
  tarotistaId   String
  tarotista     Tarotista               @relation(fields: [tarotistaId], references: [id])
  name          String
  email         String?
  phone         String?
  serviceId     String?
  service       Service?                @relation(fields: [serviceId], references: [id])
  preferredTime String?
  message       String?
  status        AttentionRequestStatus  @default(PENDING)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([tarotistaId, status])
}

/// Token de recuperación de contraseña (Fase 3). El envío real por email
/// queda preparado para la Fase 8 (SMTP); por ahora el link se registra en
/// consola/logs de servidor en vez de enviarse.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Horario de atención semanal y recurrente, configurable por el admin
/// (Fase 7). `dayOfWeek` sigue la convención de Date#getDay() (0=domingo,
/// 6=sábado). Los minutos son locales a la zona horaria del negocio
/// (siteConfig.timezone, América/Bogotá) — no UTC. Puede haber varias
/// franjas por día (ej. mañana y tarde).
model Availability {
  id          String   @id @default(cuid())
  dayOfWeek   Int
  startMinute Int
  endMinute   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dayOfWeek, active])
}

/// Bloqueo puntual (vacaciones, descansos, eventos, horas personales).
/// Guardado como instante UTC absoluto — a diferencia de `Availability`,
/// que es un patrón recurrente en hora local.
model BlockedTime {
  id        String   @id @default(cuid())
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startsAt, endsAt])
}

/// Contador atómico simple (ej. `booking_number_2026`) para numerar reservas
/// de forma correlativa sin condiciones de carrera: se actualiza con un
/// UPDATE ... SET value = value + 1, atómico a nivel de fila en Postgres.
model Counter {
  key   String @id
  value Int    @default(0)
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  RESCHEDULE_REQUESTED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// Método de pago elegido para una reserva. PayPal se captura y confirma
/// solo (ver server/paypal-orders.ts); los otros tres son de confirmación
/// MANUAL — el cliente transfiere por su cuenta, sube un comprobante
/// (manualPaymentProofUrl) y el admin revisa y confirma desde el panel
/// (mismo botón "Confirmar (pago recibido)" que ya existe, ver
/// server/admin/bookings.ts::setBookingStatus()).
enum PaymentMethod {
  PAYPAL
  PAGO_MOVIL
  ZELLE
  BINANCE
  REMITLY
  WESTERN_UNION
  MONEYGRAM
  /// Igual que los otros métodos manuales (confirmación humana, no
  /// automática) -- se descartó un agregador (Wompi) porque exige cuenta
  /// empresarial y la cuenta de Beto es de ahorros.
  BANCOLOMBIA
  /// "Pagar después" para clientes de confianza que el admin aprobó a mano
  /// (User.canUseCredit) -- no hay comprobante que subir: el admin aprueba
  /// la consulta primero (booking.status/paymentStatus siguen el mismo
  /// criterio que un pago manual confirmado) y por separado, más adelante,
  /// marca Booking.creditPaid cuando el cliente efectivamente le paga. Ver
  /// server/credit.ts.
  CREDITO_BETO
  /// Consulta regalada por el admin (nunca elegida por el cliente) --
  /// ej. para reactivar a alguien inactivo. Se crea ya CONFIRMED+PAID sin
  /// pasar por ningún flujo de pago real. Ver server/admin/gifts.ts.
  CORTESIA
}

/// Reserva de una consulta. `startsAt`/`endsAt` son instantes UTC absolutos
/// (ya calculados por el motor de disponibilidad, Fase 4). Mientras no
/// existan pagos reales (Fase 6), una reserva pasa de PENDING_PAYMENT a
/// EXPIRED si nadie la confirma manualmente antes de `paymentDeadline`.
///
/// Prevención de reservas superpuestas (Fase de agenda profesional): además
/// de la validación en el servidor al crearla, hay un EXCLUDE constraint de
/// Postgres a nivel de base de datos sobre el rango [startsAt, endsAt) para
/// reservas activas (PENDING_PAYMENT/CONFIRMED) — como Alberto es el único
/// proveedor, dos reservas activas nunca pueden solaparse en el tiempo sin
/// importar el servicio (antes era un índice único parcial sobre
/// (serviceId, startsAt), que no evitaba solapamientos entre servicios
/// distintos — ver migración `add_booking_overlap_exclude` para el detalle).
/// Agregado a mano en la migración (Prisma no soporta EXCLUDE constraints
/// de forma declarativa).
model Booking {
  id              String        @id @default(cuid())
  bookingNumber   String        @unique
  userId          String?
  user            User?         @relation(fields: [userId], references: [id])
  guestName       String?
  guestEmail      String?
  guestPhone      String?
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id])
  /// Tarotista de la consulta (Fase 6-7) — null en reservas creadas antes de
  /// esta fase, o en informes (Numerología/Carta Astral) que no pasan por
  /// disponibilidad de un tarotista. Ver server/consultations.ts.
  tarotistaId     String?
  tarotista       Tarotista?    @relation(fields: [tarotistaId], references: [id])
  startsAt        DateTime
  endsAt          DateTime
  timezone        String        @default("America/Bogota")
  status          BookingStatus @default(PENDING_PAYMENT)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentDeadline DateTime
  paypalOrderId   String?       @unique
  paypalCaptureId String?
  /// Método de pago elegido — null mientras la reserva sigue pendiente y
  /// el cliente todavía no eligió cómo pagar (o si eligió PayPal, cuyo
  /// flujo no necesita marcarlo hasta capturar). Se marca al elegir
  /// Pago Móvil/Zelle/Binance (ver server/manual-payments.ts) o al capturar
  /// PayPal.
  paymentMethod   PaymentMethod?
  /// Número de referencia/operación que el cliente escribe al pagar por
  /// Pago Móvil/Zelle/Binance — el admin lo cruza contra su estado de
  /// cuenta antes de confirmar. Null para PayPal (la referencia real es
  /// paypalCaptureId).
  manualPaymentReference String?
  /// URL (Vercel Blob) de la captura del comprobante que el cliente sube
  /// para un pago manual — visible en el panel admin antes de confirmar.
  manualPaymentProofUrl  String?
  /// Solo aplica a paymentMethod = CREDITO_BETO. Bookkeeping propio de Beto
  /// para saber si ya le pagaron una consulta a crédito -- NO participa en
  /// el gating de chat/audio/llamada (eso sigue siendo únicamente
  /// status === CONFIRMED && paymentStatus === PAID, sin cambios). Se marca
  /// aparte, después, con server/credit.ts::setCreditPaid().
  creditPaid      Boolean       @default(false)
  /// true si el cliente pidió expresamente videollamada al reservar
  /// (checkbox "Quiero videollamada (+20%)") -- dispara el recargo del 20%
  /// sobre service.price en todo lugar donde se calcula el monto a cobrar
  /// (ver lib/booking-price.ts). Sin relación con poder prender la cámara
  /// en cualquier llamada, que sigue siendo gratis para cualquiera -- esto
  /// es específicamente "pedí y pagué por video desde el vamos".
  videoRequested  Boolean       @default(false)
  /// Ajuste manual de minutos (puede ser negativo) que el admin agrega al
  /// total de minutos consumidos de esta reserva en server/admin/call-usage.ts
  /// -- para corregir el conteo automático (basado en CallLog.connectedAt/
  /// endedAt) cuando hubo un problema real de conexión que el sistema no
  /// pudo detectar solo. No afecta nada del gating de chat/llamada.
  manualMinutesAdjustment Int    @default(0)
  notes           String?
  /// Datos adicionales que algunos servicios exigen para poder realizarse
  /// (ej. fecha/hora/lugar de nacimiento para Carta Astral) — ver
  /// `lib/service-intake.ts`. Null si el servicio no pide nada extra.
  intakeData      Json?
  /// Horas-antes (24, 2, ...) para las que ya se envió recordatorio — evita
  /// reenviar el mismo recordatorio si `sendDueReminders` corre varias veces.
  remindersSentHours Int[]      @default([])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions PaypalTransaction[]
  messages     Message[]
  callLogs     CallLog[]

  @@index([userId])
  @@index([serviceId, startsAt])
  @@index([status, paymentDeadline])
  @@index([tarotistaId])
}

enum MessageSenderRole {
  CLIENT
  TAROTISTA
}

enum MessageType {
  TEXT
  AUDIO
}

/// Chat de una consulta (app móvil + web) — un hilo por reserva, solo
/// utilizable mientras la reserva esté CONFIRMED + PAID (ver
/// server/messages.ts, mismo criterio de habilitación que las llamadas de
/// audio). `senderName` queda guardado en el momento del envío (no se
/// recalcula desde User/Tarotista) para que el historial no cambie si
/// alguien edita su nombre después. `type` distingue mensajes de texto de
/// notas de voz: en AUDIO, `text` queda null y se usan `audioUrl`/
/// `audioDurationSeconds` (archivo en Vercel Blob, mismo mecanismo que los
/// comprobantes de pago).
model Message {
  id                   String            @id @default(cuid())
  bookingId            String
  booking              Booking           @relation(fields: [bookingId], references: [id])
  senderRole           MessageSenderRole
  senderName           String
  type                 MessageType       @default(TEXT)
  text                 String?
  audioUrl             String?
  audioDurationSeconds Int?
  readAt               DateTime?
  createdAt            DateTime          @default(now())

  @@index([bookingId, createdAt])
}

enum CallLogStatus {
  STARTED
  COMPLETED
  MISSED
  REJECTED
}

/// Registro de cada llamada de voz (LiveKit) iniciada -- ni la lógica de
/// acceso (server/calls.ts::getCallAccess) ni la de conexión cambian, esto
/// solo deja constancia de inicio/fin. `bookingId` es null para llamadas
/// internas admin↔tarotista (server/internal-calls.ts, room fijo
/// `internal-<tarotistaId>`, sin relación con una reserva).
model CallLog {
  id        String        @id @default(cuid())
  bookingId String?
  booking   Booking?      @relation(fields: [bookingId], references: [id])
  roomName  String
  startedAt DateTime      @default(now())
  /// Momento en que la OTRA persona realmente entró a la sala (LiveKit
  /// RoomEvent.ParticipantConnected desde el cliente, ver
  /// server/calls.ts::markCallConnected) -- null si nadie contestó. Los
  /// minutos consumidos (server/admin/call-usage.ts) se cuentan desde acá,
  /// nunca desde `startedAt`, para no facturar el tiempo de timbrado si la
  /// otra persona nunca atendió.
  connectedAt DateTime?
  endedAt   DateTime?
  status    CallLogStatus @default(STARTED)

  @@index([bookingId])
}

/// Registro de auditoría de cada orden PayPal asociada a una reserva.
/// `status` refleja el ciclo de vida de la orden en PayPal (CREATED,
/// APPROVED, COMPLETED, FAILED, REFUNDED), separado del `paymentStatus`
/// de la reserva para no perder el historial si hay varios intentos.
model PaypalTransaction {
  id              String   @id @default(cuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id])
  paypalOrderId   String   @unique
  paypalCaptureId String?
  status          String
  amount          Decimal  @db.Decimal(10, 2)
  currency        String
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([bookingId])
}

/// Deduplicación de eventos de webhook de PayPal: PayPal puede reenviar el
/// mismo evento más de una vez, así que antes de procesar cualquier evento
/// se intenta crear esta fila con su `eventId`; si ya existe (violación de
/// unicidad), el evento ya se procesó y se responde 200 sin repetir nada.
model PaypalWebhookEvent {
  id         String   @id @default(cuid())
  eventId    String   @unique
  eventType  String
  receivedAt DateTime @default(now())
}

/// Auditoría de acciones administrativas (Fase 7): quién cambió qué y
/// cuándo. `targetType`/`targetId` identifican el registro afectado
/// (ej. "Booking"/id) para poder filtrar el historial de una entidad.
model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String
  targetType String
  targetId   String
  details    String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([adminId, createdAt])
}
