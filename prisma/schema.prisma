// Fase 2: contenido dinámico (servicios, testimonios, configuración).
// Fase 3: usuarios y autenticación.
// Tablas de reservas/pagos se agregan en fases posteriores (4-6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceModality {
  VIDEOLLAMADA
  LLAMADA
  PRESENCIAL
}

model Service {
  id              String           @id @default(cuid())
  slug            String           @unique
  name            String
  description     String
  durationMinutes Int
  price           Decimal          @db.Decimal(10, 2)
  currency        String           @default("USD")
  available       Boolean          @default(true)
  modality        ServiceModality  @default(VIDEOLLAMADA)
  category        String
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([available, sortOrder])
}

enum TestimonialStatus {
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
}

model Testimonial {
  id        String            @id @default(cuid())
  name      String
  text      String
  rating    Int
  status    TestimonialStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([status, createdAt])
}

/// Configuración editable por el admin (Fase 7): textos de "quiénes somos",
/// FAQ, contacto, políticas, etc. Clave/valor flexible; `value` guarda JSON.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  CLIENT
}

model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String?
  email        String   @unique
  phone        String?
  country      String?
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passwordResets PasswordReset[]

  @@index([role])
}

/// Token de recuperación de contraseña (Fase 3). El envío real por email
/// queda preparado para la Fase 8 (SMTP); por ahora el link se registra en
/// consola/logs de servidor en vez de enviarse.
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
