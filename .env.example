# ============================================================
# TAROT DE BETO — variables de entorno
# Copia este archivo a .env.local y completa los valores.
# Las variables NEXT_PUBLIC_* son visibles en el navegador:
# NUNCA coloques secretos (contraseñas, client secrets, DB URL) ahí.
# ============================================================

# --- Fase 0/1: marca y contacto (públicas) ---
NEXT_PUBLIC_BRAND_NAME="Universo de Beto"
NEXT_PUBLIC_SITE_NAME="Tarot de Beto"
NEXT_PUBLIC_TAGLINE="La carta ya sabe lo que tú preguntas."
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_CONTACT_EMAIL=""
NEXT_PUBLIC_WHATSAPP_NUMBER=""
NEXT_PUBLIC_TIKTOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_YOUTUBE_URL=""
NEXT_PUBLIC_CURRENCY="USD"
NEXT_PUBLIC_BUSINESS_TIMEZONE="America/Bogota"

# --- Fase 2: base de datos (solo servidor) ---
DATABASE_URL=""

# --- Fase 3: autenticación (solo servidor) ---
# Firma los JWT de sesión (cookie httpOnly). Generar con `openssl rand -base64 32`.
AUTH_SECRET=""


# Fase 5 (reservas): la ventana de pago y el buffer entre consultas son
# configurables desde la tabla `Setting` (booking_payment_window_minutes,
# booking_buffer_minutes), no variables de entorno — editable por el admin
# en la Fase 7 sin redeploy. Ver prisma/seed.ts para los valores iniciales.

# --- Fase 6: PayPal ---
# El Client ID NO es secreto (PayPal lo expone a propósito para cargar el
# botón en el navegador) — por eso lleva NEXT_PUBLIC_. El resto es
# exclusivamente de servidor; PAYPAL_CLIENT_SECRET jamás debe llevar
# NEXT_PUBLIC_ ni exponerse al frontend.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_WEBHOOK_ID=""

# Pago Móvil/Zelle/Binance son de confirmación MANUAL (sin pasarela): el
# cliente sube una captura del comprobante (ver
# app/api/uploads/payment-proof/route.ts) que se guarda en Vercel Blob.
# En producción (Vercel), basta con conectar un Blob Store al proyecto
# desde Storage → Create Database → Blob → Connect to Project — Vercel
# resuelve la autenticación solo (token clásico u OIDC, según cómo quede
# conectado), no hace falta pegar nada acá a mano. Esta variable solo
# aplica para desarrollo local si querés probar subidas reales fuera de
# Vercel. Los datos de contacto (número de Pago Móvil, correo Zelle, etc.)
# se editan desde /admin/configuracion (setting "manual_payment_instructions"),
# no acá.
BLOB_READ_WRITE_TOKEN=""

# --- Notificaciones push del tarotista (Fase 9) ---
# Par de claves VAPID propio, estándar Web Push del navegador — sin
# proveedor externo ni costo. Generar con `npx web-push generate-vapid-keys`
# y usar un par DISTINTO en producción (nunca reutilizar el de desarrollo).
# La pública lleva NEXT_PUBLIC_ porque el navegador la necesita para
# suscribirse; la privada es exclusiva de servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# --- Fase 8: email transaccional (solo servidor) ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM=""

# Protege GET /api/cron/maintenance (header "Authorization: Bearer <valor>").
# Generar con `openssl rand -base64 32`. Sin esto configurado, el endpoint
# rechaza cualquier solicitud (503). Expira reservas vencidas (avisando por
# email) y manda los recordatorios de consulta (24h/2h antes, configurable
# en Setting.reminder_hours_before). En desarrollo también hay un botón
# manual equivalente en /admin ("Ejecutar mantenimiento ahora") — hace
# falta un cron real (ej. Vercel Cron) para producción.
CRON_SECRET=""

# WhatsApp Business API (Cloud API de Meta) — arquitectura preparada, NO
# implementada todavía (ver lib/whatsapp-business.ts). Hoy el contacto por
# WhatsApp es manual vía enlaces wa.me con mensaje prellenado.
WHATSAPP_BUSINESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# --- Fase 9: analítica opcional (públicas) ---
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""
