# Base de datos dedicada para pruebas automatizadas (Fase 10). Separada de
# `tarot_de_beto` (desarrollo) para que `npm run test` pueda limpiar tablas
# libremente sin arriesgar los datos de seed que usas para probar a mano en
# el navegador. Ver README → "Pruebas".
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/tarot_de_beto_test"
AUTH_SECRET="test-secret-not-for-production-0123456789"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_TIMEZONE="America/Bogota"
